  "version": "1.0.0",
  "repository": {
    "url": "https://github.com/xyver/daedal-map",
    "source": "github"
  },
  "websiteUrl": "https://www.daedalmap.com",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://app.daedalmap.com/mcp"
