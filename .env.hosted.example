# DaedalMap hosted/server example environment
#
# Use this alongside `.env.example` when deploying the public app in a hosted
# environment. These are mostly server-only or production-tuning variables.

# -----------------------------------------------------------------------------
# Runtime mode
# -----------------------------------------------------------------------------
DEPLOYMENT=railway
INSTALL_MODE=cloud
RUNTIME_MODE=cloud

# -----------------------------------------------------------------------------
# Hosted URLs
# -----------------------------------------------------------------------------
APP_URL=https://app.daedalmap.com
SITE_URL=https://www.daedalmap.com
APP_URL_ALIASES=

# -----------------------------------------------------------------------------
# Cloud-backed runtime data
# -----------------------------------------------------------------------------
S3_BUCKET=
S3_PREFIX=published
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# -----------------------------------------------------------------------------
# Server-side account and verifier features
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
COMMERCIAL_ACCESS_ENABLED=true
COMMERCIAL_ACCESS_VERIFIER_BASE_URL=
COMMERCIAL_ACCESS_TIMEOUT_SECONDS=
CLOUD_INTERNAL_API_TOKEN=

# -----------------------------------------------------------------------------
# Analytics and request hardening
# -----------------------------------------------------------------------------
API_ANALYTICS_IP_SALT=
MAX_REQUEST_BODY_BYTES=1048576
TRUST_PROXY_HEADERS=true
TRUSTED_PROXY_CIDRS=
TRUSTED_PROXY_IP_HEADERS=
CORS_ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# DuckDB tuning
# -----------------------------------------------------------------------------
DUCKDB_CACHE_TTL=300
DUCKDB_MEMORY_LIMIT=512MB

# -----------------------------------------------------------------------------
# Hosted/API policy controls
# -----------------------------------------------------------------------------
HOSTED_PACK_REF_ALLOWED_HOSTS=
ORDER_TAKER_SOURCE_MODE=
AGENT_API_DISCOVERY_RATE_LIMIT=
AGENT_API_DISCOVERY_RATE_WINDOW_SECONDS=
APP_CATALOG_RATE_LIMIT=
APP_CATALOG_RATE_WINDOW_SECONDS=
AGENT_API_PAID_RATE_LIMIT=
AGENT_API_PAID_RATE_WINDOW_SECONDS=
AGENT_API_MCP_RATE_LIMIT=
AGENT_API_MCP_RATE_WINDOW_SECONDS=
SHARED_RUNTIME_ANON_RATE_LIMIT=
SHARED_RUNTIME_ANON_RATE_WINDOW_SECONDS=
API_QUERY_MAX_CONCURRENCY_PER_CALLER=
API_QUERY_MAX_CONCURRENCY_GLOBAL=
QUERY_MAX_UNSCOPED_YEARS=
QUERY_MAX_REGION_YEARS=
QUERY_MAX_AGGREGATE_UNSCOPED_YEARS=
QUERY_MAX_REGION_IDS=
QUERY_REJECT_WORK_SCORE=

# -----------------------------------------------------------------------------
# Optional hosted/admin helpers
# -----------------------------------------------------------------------------
RESEARCH_MODEL=
RESEARCH_TEMPERATURE=
CONFIRMED_ORDER_RATE_WINDOW_SECONDS=
CONFIRMED_ORDER_RATE_LIMIT_AUTH=
CONFIRMED_ORDER_RATE_LIMIT_ANON=
ORDER_STATUS_RATE_LIMIT=
ORDER_STATUS_RATE_WINDOW_SECONDS=

# -----------------------------------------------------------------------------
# Local/private test helpers
# Do not use browser-exposed secrets here.
# -----------------------------------------------------------------------------
DAEDALMAP_API_BASE_URL=
EVM_PRIVATE_KEY=
