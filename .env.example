# DaedalMap public app example environment
#
# This file is intentionally lean: local development, normal self-hosting,
# and browser-safe service configuration.
#
# For hosted production/server-side extras, see `.env.hosted.example`.

# -----------------------------------------------------------------------------
# LLM providers
# Set at least one for normal chat/order-taking use.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# -----------------------------------------------------------------------------
# Frontend/browser-facing services
# -----------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=your_google_maps_browser_key_here
SUPABASE_URL=
SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Runtime basics
# -----------------------------------------------------------------------------
DEPLOYMENT=local
INSTALL_MODE=local
RUNTIME_MODE=local
PORT=7000
APP_URL=http://localhost:7000
SITE_URL=http://localhost:8080

# Leave blank unless you intentionally want to override the default local
# app-data folders.
DATA_ROOT=
PACKS_ROOT=
CONFIG_DIR=
STATE_DIR=
CACHE_DIR=
LOG_DIR=
RUNTIME_CONFIG_PATH=

# -----------------------------------------------------------------------------
# Cloud-backed runtime data
# Useful for self-hosting against published pack storage.
# -----------------------------------------------------------------------------
S3_BUCKET=
S3_PREFIX=published
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# -----------------------------------------------------------------------------
# Local test client helpers
# -----------------------------------------------------------------------------
DAEDALMAP_API_BASE_URL=
