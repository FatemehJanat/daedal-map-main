# Minimal DaedalMap GitHub/local setup
#
# Copy this file to `.env` and point DATA_ROOT at your local data tree. No S3,
# R2, AWS, database, account, hosted-control-plane, or model API configuration
# is required for local data operations.

DEPLOYMENT=local
INSTALL_MODE=local
RUNTIME_MODE=local
PORT=7000

# Use an explicit local data tree. Leave blank only if you want DaedalMap's
# default per-user app-data location.
DATA_ROOT=C:/path/to/your/data

# Optional: set ONE provider key only for the built-in local chat UI.
# Researchers using the hosted Research MCP from an MCP-capable subscription
# client do not need either key here.
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: enables Google-backed browser map services when your setup uses
# them. Data queries and local pack storage do not depend on this key.
# GOOGLE_MAPS_API_KEY=your_google_maps_browser_key_here
